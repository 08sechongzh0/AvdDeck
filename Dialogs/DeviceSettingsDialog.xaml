<Window x:Class="AvdDeck.Dialogs.DeviceSettingsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设备配置" Width="480" Height="500" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="Transparent" WindowStyle="None" AllowsTransparency="True">
  <Border Background="#151922" BorderBrush="#323948" BorderThickness="1" CornerRadius="16" Padding="26">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="设备配置" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="Subtitle" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel>
        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="Cancel_Click"/>
      </Grid>
      <StackPanel Grid.Row="1" Margin="0,26,0,0">
        <TextBlock Text="内存 (MB)" Foreground="#A8B0C0" FontSize="12" Margin="0,0,0,8"/><TextBox x:Name="RamBox" Height="42"/>
        <TextBlock Text="CPU 核心数" Foreground="#A8B0C0" FontSize="12" Margin="0,18,0,8"/>
        <ComboBox x:Name="CoreBox" SelectedIndex="3"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="6"/><ComboBoxItem Content="8"/></ComboBox>
        <TextBlock Text="图形加速" Foreground="#A8B0C0" FontSize="12" Margin="0,18,0,8"/>
        <ComboBox x:Name="GpuBox" SelectedIndex="0"><ComboBoxItem Content="自动" Tag="auto"/><ComboBoxItem Content="主机 GPU" Tag="host"/><ComboBoxItem Content="软件渲染" Tag="swiftshader_indirect"/><ComboBoxItem Content="关闭" Tag="off"/></ComboBox>
        <CheckBox x:Name="KeyboardBox" Content="启用物理键盘输入" Foreground="#DCE1EA" Margin="0,20,0,0"/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" FontSize="11" Margin="0,12,0,0"/>
      </StackPanel>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button Style="{StaticResource SecondaryButton}" Content="取消" Click="Cancel_Click"/><Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="保存配置" Click="Save_Click"/>
      </Grid>
    </Grid>
  </Border>
</Window>

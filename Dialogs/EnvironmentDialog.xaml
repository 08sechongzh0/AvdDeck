<Window x:Class="AvdDeck.Dialogs.EnvironmentDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="环境检测" Width="560" Height="610" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="Transparent" WindowStyle="None" AllowsTransparency="True">
  <Border Background="#151922" BorderBrush="#323948" BorderThickness="1" CornerRadius="16" Padding="26">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Android 环境检测" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="检查运行 AVD 所需的组件与虚拟设备" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel>
        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="Close_Click"/>
      </Grid>

      <Border Grid.Row="1" x:Name="SummaryCard" Background="#171D27" BorderBrush="#2E3847" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,22,0,16">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border x:Name="SummaryIconBg" Width="34" Height="34" CornerRadius="10" Background="#17382D"><TextBlock x:Name="SummaryIcon" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Success}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="SummaryTitle" Text="正在检测…" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="SummaryText" Text="请稍候" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
        </Grid>
      </Border>

      <StackPanel Grid.Row="2">
        <Border Background="#11151D" CornerRadius="11" Padding="15,12" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" Foreground="#A999FF" Width="28"/><TextBlock Text="Android SDK 目录"/></StackPanel><TextBlock x:Name="SdkCheck" Grid.Column="1" Text="检测中" Foreground="{StaticResource Muted}"/></Grid></Border>
        <Border Background="#11151D" CornerRadius="11" Padding="15,12" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE756;" FontFamily="Segoe Fluent Icons" Foreground="#A999FF" Width="28"/><TextBlock Text="命令行工具"/></StackPanel><TextBlock x:Name="ToolsCheck" Grid.Column="1" Text="检测中" Foreground="{StaticResource Muted}"/></Grid></Border>
        <Border Background="#11151D" CornerRadius="11" Padding="15,12" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" Foreground="#A999FF" Width="28"/><TextBlock Text="Android Emulator"/></StackPanel><TextBlock x:Name="EmulatorCheck" Grid.Column="1" Text="检测中" Foreground="{StaticResource Muted}"/></Grid></Border>
        <Border Background="#11151D" CornerRadius="11" Padding="15,12" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE950;" FontFamily="Segoe Fluent Icons" Foreground="#A999FF" Width="28"/><TextBlock Text="ADB 平台工具"/></StackPanel><TextBlock x:Name="AdbCheck" Grid.Column="1" Text="检测中" Foreground="{StaticResource Muted}"/></Grid></Border>
        <Border Background="#11151D" CornerRadius="11" Padding="15,12" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="&#xEBD3;" FontFamily="Segoe Fluent Icons" Foreground="#A999FF" Width="28"/><TextBlock Text="Android 系统镜像"/></StackPanel><TextBlock x:Name="ImageCheck" Grid.Column="1" Text="检测中" Foreground="{StaticResource Muted}"/></Grid></Border>
        <Border Background="#11151D" CornerRadius="11" Padding="15,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EC;" FontFamily="Segoe Fluent Icons" Foreground="#A999FF" Width="28"/><TextBlock Text="虚拟设备 (AVD)"/></StackPanel><TextBlock x:Name="AvdCheck" Grid.Column="1" Text="检测中" Foreground="{StaticResource Muted}"/></Grid></Border>
      </StackPanel>

      <StackPanel Grid.Row="3" Margin="0,18,0,0">
        <ProgressBar x:Name="InstallProgress" Height="4" Minimum="0" Maximum="100" Foreground="{StaticResource Accent}" Background="#242A36" Visibility="Collapsed"/>
        <TextBlock x:Name="ProgressText" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,10" TextTrimming="CharacterEllipsis"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.6*"/></Grid.ColumnDefinitions>
          <Button x:Name="RecheckButton" Style="{StaticResource SecondaryButton}" Content="重新检测" Click="Recheck_Click"/>
          <Button x:Name="InstallButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="一键安装并创建" Click="Install_Click"/>
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</Window>

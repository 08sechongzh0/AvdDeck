<Window x:Class="AvdDeck.Dialogs.ConfirmDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="430" Height="270" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="Transparent" WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False">
  <Border Background="#171B24" BorderBrush="#3B4353" BorderThickness="1" CornerRadius="16" Padding="26">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal"><Border x:Name="IconBg" Width="40" Height="40" CornerRadius="12" Background="#352629" Margin="0,0,14,0"><TextBlock x:Name="DialogIcon" Text="&#xEA39;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Danger}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
      <TextBlock x:Name="MessageText" Grid.Row="1" Foreground="#A7AFBF" FontSize="12" TextWrapping="Wrap" Margin="0,18,0,18" LineHeight="20"/>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Style="{StaticResource SecondaryButton}" Content="取消" Click="Cancel_Click"/><Button x:Name="ConfirmButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="Confirm_Click"/></Grid>
    </Grid>
  </Border>
</Window>

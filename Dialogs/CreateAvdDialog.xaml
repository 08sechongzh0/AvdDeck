<Window x:Class="AvdDeck.Dialogs.CreateAvdDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建虚拟设备" Width="520" Height="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#11141B" WindowStyle="None" AllowsTransparency="True">
  <Border Background="#151922" BorderBrush="#323948" BorderThickness="1" CornerRadius="16" Padding="26">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="新建虚拟设备" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="使用已安装的系统镜像创建 AVD" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel>
        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="Cancel_Click"/>
      </Grid>
      <StackPanel Grid.Row="1" Margin="0,28,0,0">
        <TextBlock Text="设备名称" Foreground="#A8B0C0" FontSize="12" Margin="0,0,0,8"/><TextBox x:Name="NameBox" Height="42" Text="My_Android_Device"/>
        <Grid Margin="0,20,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="硬件模板" Foreground="#A8B0C0" FontSize="12"/><TextBlock x:Name="DeviceHint" Grid.Column="1" Text="正在后台加载…" Foreground="#7C5CFC" FontSize="10"/></Grid>
        <ComboBox x:Name="DeviceBox" DisplayMemberPath="Label" IsEnabled="False"/>
        <TextBlock Text="系统镜像" Foreground="#A8B0C0" FontSize="12" Margin="0,20,0,8"/><ComboBox x:Name="ImageBox" DisplayMemberPath="Label"/>
        <Border x:Name="NoImages" Background="#301F23" BorderBrush="#61333B" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,10,0,0" Visibility="Collapsed"><TextBlock Text="没有检测到已安装的系统镜像。请先通过 Android Studio 安装。" Foreground="#F0A4A0" FontSize="11" TextWrapping="Wrap"/></Border>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" FontSize="11" Margin="0,12,0,0"/>
      </StackPanel>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button Style="{StaticResource SecondaryButton}" Content="取消" Click="Cancel_Click"/><Button x:Name="CreateButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="创建设备" Click="Create_Click" IsEnabled="False"/>
      </Grid>
    </Grid>
  </Border>
</Window>

<Window x:Class="AvdDeck.Dialogs.SnapshotDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快照管理" Width="620" Height="650" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="Transparent" WindowStyle="None" AllowsTransparency="True">
  <Window.Resources>
    <Style x:Key="SnapshotItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Bg" Background="#11151D" BorderBrush="#2B3240" BorderThickness="1" CornerRadius="10" Padding="13"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#1C222D"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Bg" Property="Background" Value="#251F3B"/><Setter TargetName="Bg" Property="BorderBrush" Value="#7058DD"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border Background="#151922" BorderBrush="#323948" BorderThickness="1" CornerRadius="16" Padding="26">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="快照管理" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="Subtitle" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel>
        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="Close_Click"/>
      </Grid>

      <Border Grid.Row="1" Background="#11151D" BorderBrush="#2B3240" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,20,0,15">
        <StackPanel Orientation="Horizontal"><Ellipse x:Name="StateDot" Width="7" Height="7" Margin="0,0,8,0"/><TextBlock x:Name="StateText" FontSize="11"/></StackPanel>
      </Border>

      <Grid Grid.Row="2" Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="NameBox" Height="42" VerticalContentAlignment="Center"/>
        <Button x:Name="SaveButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="创建快照" Click="Save_Click"/>
      </Grid>

      <Grid Grid.Row="3">
        <ListBox x:Name="SnapshotList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SnapshotItem}" SelectionChanged="SnapshotList_SelectionChanged">
          <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="34" Height="34" CornerRadius="9" Background="#2A2447"><TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons" Foreground="#B9ABFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"/><Border x:Name="QuickBadge" Background="#18382E" CornerRadius="5" Padding="6,2" Margin="8,0,0,0" Visibility="Collapsed"><TextBlock Text="系统" Foreground="#63E6A6" FontSize="9"/></Border></StackPanel><TextBlock Text="{Binding ModifiedText}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/></StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="#8F98AA" FontSize="11" VerticalAlignment="Center"/>
          </Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding IsQuickBoot}" Value="True"><Setter TargetName="QuickBadge" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"><TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="#4C566A" HorizontalAlignment="Center"/><TextBlock Text="暂无快照" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel>
        <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Height="2" VerticalAlignment="Top" Foreground="{StaticResource Accent}" Background="Transparent" Visibility="Collapsed"/>
      </Grid>

      <Grid Grid.Row="4" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="刷新" Click="Refresh_Click"/>
        <Button x:Name="DeleteButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="删除快照" Foreground="{StaticResource Danger}" Click="Delete_Click" IsEnabled="False"/>
        <Button x:Name="LoadButton" Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="加载快照" Click="Load_Click" IsEnabled="False"/>
      </Grid>
    </Grid>
  </Border>
</Window>
